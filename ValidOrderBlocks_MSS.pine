//@version=5
// =============================================================================
//  VALID ORDER BLOCKS  —  Liquidity Sweep + MSS + FVG (ICT-style) [Premium]
//  Valid OBs (sweep -> MSS close -> FVG -> last opposing candle) + confidence,
//  MTF order blocks, MTF trend panel, swing lines, live HH/LL, full styling.
// =============================================================================
indicator("Valid Order Blocks — MSS + Liquidity + FVG [Premium]", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// -----------------------------------------------------------------------------
//  INPUTS
// -----------------------------------------------------------------------------
grpS = "① Structure Detection"
pivotLen      = input.int(8,   "Swing Pivot Length",     minval = 2, maxval = 50, group = grpS, tooltip = "Bars left/right used to confirm a swing high / swing low. Higher = only major swings.")
requireSweep  = input.bool(true,"Require Liquidity Sweep", group = grpS)
sweepLookback = input.int(60,  "Sweep Lookback (bars)",  minval = 5, maxval = 300, group = grpS)
requireFVG    = input.bool(true,"Require Fair Value Gap", group = grpS)
legLookback   = input.int(15,  "Displacement Leg Lookback", minval = 3, maxval = 60, group = grpS)

grpF = "② Order Block Filtering"
useConfFilter = input.bool(true, "Hide Blocks Below Min Confidence", group = grpF)
minConf       = input.int(50, "Minimum Confidence (%)", minval = 0, maxval = 100, group = grpF)
mitigation    = input.string("Wick", "Mitigation (invalidate on)", options = ["Wick","Close"], group = grpF)
maxActiveOB   = input.int(8, "Max Active OBs per side", minval = 1, maxval = 30, group = grpF)
showMitigated = input.bool(false, "Keep Mitigated OBs (faded)", group = grpF)

grpM = "③ Multi-Timeframe Order Blocks"
mtfOn   = input.bool(true,  "Show Higher-TF Order Blocks", group = grpM)
mtfTF   = input.timeframe("60", "HTF for Order Blocks", group = grpM)

grpP = "④ MTF Trend Panel"
panelOn   = input.bool(true, "Show MTF Trend Panel", group = grpP)
panelPos  = input.string("Top Right", "Panel Position", options = ["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right"], group = grpP)
emaLen    = input.int(50, "Trend EMA Length", minval = 5, group = grpP)
tf1 = input.timeframe("15",  "TF 1", group = grpP)
tf2 = input.timeframe("60",  "TF 2", group = grpP)
tf3 = input.timeframe("240", "TF 3", group = grpP)
tf4 = input.timeframe("D",   "TF 4", group = grpP)

grpV = "⑤ Visuals & Colors"
bullCol   = input.color(color.new(#26a69a, 0),  "Bullish OB",  group = grpV, inline = "c1")
bearCol   = input.color(color.new(#ef5350, 0),  "Bearish OB",  group = grpV, inline = "c1")
obTransp  = input.int(82, "OB Fill Transp", minval = 0, maxval = 100, group = grpV)
showFVGbx = input.bool(true, "Draw FVG Boxes", group = grpV)
fvgBullCol= input.color(color.new(#26a69a, 60), "FVG Bull", group = grpV, inline = "fvgc")
fvgBearCol= input.color(color.new(#ef5350, 60), "FVG Bear", group = grpV, inline = "fvgc")
bgOn      = input.bool(true, "Premium Background Tint", group = grpV)
bgBullCol = input.color(#26a69a, "BG Bull", group = grpV, inline = "bgc")
bgBearCol = input.color(#ef5350, "BG Bear", group = grpV, inline = "bgc")
bgIntens  = input.int(94, "Background Transp", minval = 80, maxval = 99, group = grpV)
showLabels= input.bool(true, "Show OB Confidence Text", group = grpV)
showSwings = input.bool(true, "Show Swing High/Low Lines", group = grpV)
swingHiCol = input.color(color.new(#ef5350, 20), "Swing High Line", group = grpV, inline = "sw")
swingLoCol = input.color(color.new(#26a69a, 20), "Swing Low Line",  group = grpV, inline = "sw")

grpH = "⑥ Higher-High / Lower-Low"
showHHLL   = input.bool(true, "Show Live HH / LL Markers", group = grpH)
hhCol      = input.color(color.new(#26a69a, 0), "Higher High", group = grpH, inline = "hl")
llCol      = input.color(color.new(#ef5350, 0), "Lower Low",   group = grpH, inline = "hl")
hhllShowVal= input.bool(true, "Show Price Value on Marker", group = grpH)
hhllLine   = input.bool(true, "Draw Live HH/LL Level Lines", group = grpH, tooltip = "Extend a horizontal line at the most recent HH and LL up to the current bar, updating live.")

grpST = "⑦ Global Styling"
obBorderW  = input.int(1, "OB Border Width",  minval = 1, maxval = 5, group = grpST)
obTextSz   = input.string("Small",  "OB Text Size",    options = ["Tiny","Small","Normal","Large"], group = grpST)
swingStyle = input.string("Dashed", "Swing Line Style", options = ["Solid","Dashed","Dotted"], group = grpST, inline = "sw2")
swingWidth = input.int(1, "Width", minval = 1, maxval = 5, group = grpST, inline = "sw2")
swingTagSz = input.string("Small",  "Swing/HHLL Tag Size", options = ["Tiny","Small","Normal","Large"], group = grpST)
fvgStyle   = input.string("Dotted", "FVG Border Style", options = ["Solid","Dashed","Dotted"], group = grpST, inline = "fv")
fvgBorderW = input.int(1, "Width", minval = 1, maxval = 5, group = grpST, inline = "fv")
htfStyle   = input.string("Dashed", "HTF OB Style", options = ["Solid","Dashed","Dotted"], group = grpST, inline = "ht")
htfBorderW = input.int(2, "Width", minval = 1, maxval = 5, group = grpST, inline = "ht")
panelTextSz= input.string("Normal", "Panel Text Size", options = ["Tiny","Small","Normal","Large"], group = grpST)

// -----------------------------------------------------------------------------
//  HELPERS
// -----------------------------------------------------------------------------
f_transpColor(_c, _t) => color.new(_c, _t)
f_lineStyle(_s) => _s == "Dashed" ? line.style_dashed : _s == "Dotted" ? line.style_dotted : line.style_solid
f_size(_s)      => _s == "Tiny" ? size.tiny : _s == "Normal" ? size.normal : _s == "Large" ? size.large : size.small

f_trendScore() =>
    e = ta.ema(close, emaLen)
    up = close > e and e > e[2]
    dn = close < e and e < e[2]
    up ? 1 : dn ? -1 : 0

// -----------------------------------------------------------------------------
//  1) SWING PIVOTS
// -----------------------------------------------------------------------------
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
var int   lastSwingHighBar = na
var int   lastSwingLowBar  = na

if not na(ph)
    lastSwingHigh    := ph
    lastSwingHighBar := bar_index - pivotLen
if not na(pl)
    lastSwingLow    := pl
    lastSwingLowBar := bar_index - pivotLen

// -----------------------------------------------------------------------------
//  HIGHER-HIGH / LOWER-LOW classification (marker on each qualifying swing)
// -----------------------------------------------------------------------------
var float prevPH = na
var float prevPL = na
var float lastHH = na
var float lastLL = na
var int   hhBar  = na
var int   llBar  = na

if not na(ph)
    if not na(prevPH) and ph > prevPH
        lastHH := ph
        hhBar  := bar_index - pivotLen
        if showHHLL
            string tx = hhllShowVal ? "HH  " + str.tostring(ph, format.mintick) : "HH"
            label.new(bar_index - pivotLen, ph, tx, style = label.style_label_down, color = f_transpColor(hhCol, 15), textcolor = color.white, size = f_size(swingTagSz))
    prevPH := ph

if not na(pl)
    if not na(prevPL) and pl < prevPL
        lastLL := pl
        llBar  := bar_index - pivotLen
        if showHHLL
            string tx = hhllShowVal ? "LL  " + str.tostring(pl, format.mintick) : "LL"
            label.new(bar_index - pivotLen, pl, tx, style = label.style_label_up, color = f_transpColor(llCol, 15), textcolor = color.white, size = f_size(swingTagSz))
    prevPL := pl

// Live HH / LL level lines (extend to current bar each bar)
var line hhLine = na
var line llLine = na
if hhllLine and showHHLL
    if not na(lastHH)
        if na(hhLine)
            hhLine := line.new(hhBar, lastHH, bar_index, lastHH, color = hhCol, style = f_lineStyle(swingStyle), width = swingWidth)
        else
            line.set_xy1(hhLine, hhBar, lastHH)
            line.set_xy2(hhLine, bar_index, lastHH)
    if not na(lastLL)
        if na(llLine)
            llLine := line.new(llBar, lastLL, bar_index, lastLL, color = llCol, style = f_lineStyle(swingStyle), width = swingWidth)
        else
            line.set_xy1(llLine, llBar, lastLL)
            line.set_xy2(llLine, bar_index, lastLL)

// -----------------------------------------------------------------------------
//  LIQUIDITY SWEEP tracking
// -----------------------------------------------------------------------------
var int sweptLowBar  = na
var int sweptHighBar = na
if not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow and (bar_index - lastSwingLowBar) <= sweepLookback
    sweptLowBar := bar_index
if not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh and (bar_index - lastSwingHighBar) <= sweepLookback
    sweptHighBar := bar_index

// -----------------------------------------------------------------------------
//  2) MARKET STRUCTURE SHIFT (MSS)
// -----------------------------------------------------------------------------
bullMSS = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bearMSS = not na(lastSwingLow)  and close < lastSwingLow  and close[1] >= lastSwingLow

// Swing High / Low reference lines (rolling)
var line  shLine = na
var label shLbl  = na
var line  slLine = na
var label slLbl  = na
if showSwings
    if not na(lastSwingHigh)
        if na(shLine)
            shLine := line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color = swingHiCol, style = f_lineStyle(swingStyle), width = swingWidth)
            shLbl  := label.new(bar_index, lastSwingHigh, "SH", style = label.style_label_left, color = color.new(swingHiCol, 100), textcolor = swingHiCol, size = f_size(swingTagSz))
        else
            line.set_xy1(shLine, lastSwingHighBar, lastSwingHigh)
            line.set_xy2(shLine, bar_index, lastSwingHigh)
            label.set_xy(shLbl, bar_index, lastSwingHigh)
    if not na(lastSwingLow)
        if na(slLine)
            slLine := line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color = swingLoCol, style = f_lineStyle(swingStyle), width = swingWidth)
            slLbl  := label.new(bar_index, lastSwingLow, "SL", style = label.style_label_left, color = color.new(swingLoCol, 100), textcolor = swingLoCol, size = f_size(swingTagSz))
        else
            line.set_xy1(slLine, lastSwingLowBar, lastSwingLow)
            line.set_xy2(slLine, bar_index, lastSwingLow)
            label.set_xy(slLbl, bar_index, lastSwingLow)

// -----------------------------------------------------------------------------
//  3) FAIR VALUE GAP inside displacement leg
// -----------------------------------------------------------------------------
f_hasBullFVGin(_len) =>
    bool found = false
    float sz = 0.0
    for i = 0 to int(math.min(_len, 60))
        if low[i] > high[i + 2]
            found := true
            sz := math.max(sz, low[i] - high[i + 2])
    [found, sz]

f_hasBearFVGin(_len) =>
    bool found = false
    float sz = 0.0
    for i = 0 to int(math.min(_len, 60))
        if high[i] < low[i + 2]
            found := true
            sz := math.max(sz, low[i + 2] - high[i])
    [found, sz]

// -----------------------------------------------------------------------------
//  4) ORDER BLOCK CANDLE + CONFIDENCE
// -----------------------------------------------------------------------------
atr = ta.atr(14)

type OB
    box   b
    label lb
    float top
    float bot
    bool  bull
    bool  mitig
    int   conf

var array<OB> obs = array.new<OB>()

f_confidence(_bull, _fvgSize, _sweep, _dispBody) =>
    float score = 0
    score += math.min(35.0, (_dispBody / (atr + 1e-9)) * 20.0)
    score += math.min(30.0, (_fvgSize / (atr + 1e-9)) * 30.0)
    score += _sweep ? 25.0 : 0.0
    volOk = volume > ta.sma(volume, 20)
    score += volOk ? 10.0 : 0.0
    int(math.round(math.min(100.0, score)))

f_confText(_c) => _c >= 75 ? "HIGH" : _c >= 50 ? "MED" : "LOW"

f_findBullOB(_len) =>
    int idx = na
    for i = 1 to int(math.min(_len, 60))
        if close[i] < open[i]
            idx := i
            break
    idx

f_findBearOB(_len) =>
    int idx = na
    for i = 1 to int(math.min(_len, 60))
        if close[i] > open[i]
            idx := i
            break
    idx

// -------- Build bullish order block --------
if bullMSS
    sweepOk = not requireSweep or (not na(sweptLowBar) and (bar_index - sweptLowBar) <= sweepLookback)
    [fvgOk, fvgSz] = f_hasBullFVGin(legLookback)
    fvgPass = not requireFVG or fvgOk
    if sweepOk and fvgPass
        obi = f_findBullOB(legLookback)
        if not na(obi)
            dispBody = math.abs(close - open[obi])
            conf = f_confidence(true, fvgSz, sweepOk, dispBody)
            if not useConfFilter or conf >= minConf
                float t = math.max(open[obi], high[obi])
                float bo = math.min(low[obi], close[obi])
                label lbl = na
                string obTxt = showLabels ? (str.tostring(conf) + "%  " + f_confText(conf)) : ""
                bx = box.new(bar_index - obi, t, bar_index + 20, bo, border_color = f_transpColor(bullCol, 30), bgcolor = f_transpColor(bullCol, obTransp), border_width = obBorderW, text = obTxt, text_color = color.white, text_size = f_size(obTextSz), text_halign = text.align_right, text_valign = text.align_center)
                array.push(obs, OB.new(bx, lbl, t, bo, true, false, conf))

// -------- Build bearish order block --------
if bearMSS
    sweepOk = not requireSweep or (not na(sweptHighBar) and (bar_index - sweptHighBar) <= sweepLookback)
    [fvgOk, fvgSz] = f_hasBearFVGin(legLookback)
    fvgPass = not requireFVG or fvgOk
    if sweepOk and fvgPass
        obi = f_findBearOB(legLookback)
        if not na(obi)
            dispBody = math.abs(close - open[obi])
            conf = f_confidence(false, fvgSz, sweepOk, dispBody)
            if not useConfFilter or conf >= minConf
                float t = math.max(open[obi], high[obi])
                float bo = math.min(low[obi], close[obi])
                label lbl = na
                string obTxt = showLabels ? (str.tostring(conf) + "%  " + f_confText(conf)) : ""
                bx = box.new(bar_index - obi, t, bar_index + 20, bo, border_color = f_transpColor(bearCol, 30), bgcolor = f_transpColor(bearCol, obTransp), border_width = obBorderW, text = obTxt, text_color = color.white, text_size = f_size(obTextSz), text_halign = text.align_right, text_valign = text.align_center)
                array.push(obs, OB.new(bx, lbl, t, bo, false, false, conf))

// -----------------------------------------------------------------------------
//  MAINTAIN ORDER BLOCKS
// -----------------------------------------------------------------------------
if array.size(obs) > 0
    array<OB> keep = array.new<OB>()
    int bulls = 0
    int bears = 0
    for idx = array.size(obs) - 1 to 0
        OB o = array.get(obs, idx)
        box.set_right(o.b, bar_index + 20)
        bool hit = o.bull ? (mitigation == "Close" ? close < o.bot : low < o.bot) : (mitigation == "Close" ? close > o.top : high > o.top)
        bool drop = false
        if hit and not o.mitig
            o.mitig := true
            if showMitigated
                box.set_bgcolor(o.b, f_transpColor(o.bull ? bullCol : bearCol, 94))
                box.set_border_color(o.b, f_transpColor(color.gray, 60))
            else
                drop := true
        if not drop and not o.mitig
            if o.bull
                bulls += 1
                drop := bulls > maxActiveOB
            else
                bears += 1
                drop := bears > maxActiveOB
        if drop
            box.delete(o.b)
            label.delete(o.lb)
        else
            array.push(keep, o)
    array.clear(obs)
    if array.size(keep) > 0
        for k = array.size(keep) - 1 to 0
            array.push(obs, array.get(keep, k))

// -----------------------------------------------------------------------------
//  FVG BOXES
// -----------------------------------------------------------------------------
if showFVGbx
    if low > high[2]
        box.new(bar_index - 2, low, bar_index + 5, high[2], border_color = fvgBullCol, bgcolor = color.new(fvgBullCol, 90), border_width = fvgBorderW, border_style = f_lineStyle(fvgStyle))
    if high < low[2]
        box.new(bar_index - 2, low[2], bar_index + 5, high, border_color = fvgBearCol, bgcolor = color.new(fvgBearCol, 90), border_width = fvgBorderW, border_style = f_lineStyle(fvgStyle))

// -----------------------------------------------------------------------------
//  MULTI-TIMEFRAME ORDER BLOCKS
// -----------------------------------------------------------------------------
f_htfBullOB() =>
    disp = close > ta.highest(high[1], 3)
    float t = na
    float b = na
    if disp
        for i = 1 to 20
            if close[i] < open[i]
                t := high[i]
                b := low[i]
                break
    [t, b, disp]

f_htfBearOB() =>
    disp = close < ta.lowest(low[1], 3)
    float t = na
    float b = na
    if disp
        for i = 1 to 20
            if close[i] > open[i]
                t := high[i]
                b := low[i]
                break
    [t, b, disp]

[hBullT, hBullB, hBullDisp] = request.security(syminfo.tickerid, mtfTF, f_htfBullOB())
[hBearT, hBearB, hBearDisp] = request.security(syminfo.tickerid, mtfTF, f_htfBearOB())

var box htfBullBox = na
var box htfBearBox = na

if mtfOn
    if hBullDisp and not na(hBullT)
        if not na(htfBullBox)
            box.delete(htfBullBox)
        htfBullBox := box.new(bar_index - 30, hBullT, bar_index + 20, hBullB, border_color = color.new(bullCol, 10), bgcolor = color.new(bullCol, 88), border_width = htfBorderW, border_style = f_lineStyle(htfStyle), text = mtfTF + " Bull OB", text_color = color.new(bullCol, 0), text_size = f_size(obTextSz), text_halign = text.align_left)
    if hBearDisp and not na(hBearT)
        if not na(htfBearBox)
            box.delete(htfBearBox)
        htfBearBox := box.new(bar_index - 30, hBearT, bar_index + 20, hBearB, border_color = color.new(bearCol, 10), bgcolor = color.new(bearCol, 88), border_width = htfBorderW, border_style = f_lineStyle(htfStyle), text = mtfTF + " Bear OB", text_color = color.new(bearCol, 0), text_size = f_size(obTextSz), text_halign = text.align_left)
    if not na(htfBullBox)
        box.set_right(htfBullBox, bar_index + 20)
    if not na(htfBearBox)
        box.set_right(htfBearBox, bar_index + 20)

// -----------------------------------------------------------------------------
//  PREMIUM BACKGROUND TINT
// -----------------------------------------------------------------------------
var int structBias = 0
if bullMSS
    structBias := 1
if bearMSS
    structBias := -1

bgcolor(bgOn ? (structBias == 1 ? color.new(bgBullCol, bgIntens) : structBias == -1 ? color.new(bgBearCol, bgIntens) : na) : na)

// -----------------------------------------------------------------------------
//  MTF TREND PANEL
// -----------------------------------------------------------------------------
t1 = request.security(syminfo.tickerid, tf1, f_trendScore())
t2 = request.security(syminfo.tickerid, tf2, f_trendScore())
t3 = request.security(syminfo.tickerid, tf3, f_trendScore())
t4 = request.security(syminfo.tickerid, tf4, f_trendScore())

f_trendTxt(_s) => _s == 1 ? "▲ BULL" : _s == -1 ? "▼ BEAR" : "► FLAT"
f_trendCol(_s) => _s == 1 ? color.new(#26a69a, 0) : _s == -1 ? color.new(#ef5350, 0) : color.new(color.gray, 0)

var table panel = na
if panelOn and barstate.islast
    pos = panelPos == "Top Right" ? position.top_right : panelPos == "Top Left" ? position.top_left : panelPos == "Bottom Right" ? position.bottom_right : panelPos == "Bottom Left" ? position.bottom_left : position.middle_right
    if not na(panel)
        table.delete(panel)
    panel := table.new(pos, 2, 6, bgcolor = color.new(#0e1621, 12), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
    psz = f_size(panelTextSz)

    table.cell(panel, 0, 0, "MTF TREND", text_color = color.white, bgcolor = color.new(#1c2733, 0), text_size = psz)
    net = t1 + t2 + t3 + t4
    biasTxt = net >= 2 ? "STRONG BULL" : net <= -2 ? "STRONG BEAR" : net > 0 ? "BULL" : net < 0 ? "BEAR" : "MIXED"
    biasCol = net >= 2 ? color.new(#00e676,0) : net <= -2 ? color.new(#ff5252,0) : net > 0 ? color.new(#26a69a,0) : net < 0 ? color.new(#ef5350,0) : color.new(color.gray,0)
    table.cell(panel, 1, 0, biasTxt, text_color = color.white, bgcolor = biasCol, text_size = psz)

    table.cell(panel, 0, 1, tf1, text_color = color.silver, text_size = psz)
    table.cell(panel, 1, 1, f_trendTxt(t1), text_color = color.white, bgcolor = f_trendCol(t1), text_size = psz)
    table.cell(panel, 0, 2, tf2, text_color = color.silver, text_size = psz)
    table.cell(panel, 1, 2, f_trendTxt(t2), text_color = color.white, bgcolor = f_trendCol(t2), text_size = psz)
    table.cell(panel, 0, 3, tf3, text_color = color.silver, text_size = psz)
    table.cell(panel, 1, 3, f_trendTxt(t3), text_color = color.white, bgcolor = f_trendCol(t3), text_size = psz)
    table.cell(panel, 0, 4, tf4, text_color = color.silver, text_size = psz)
    table.cell(panel, 1, 4, f_trendTxt(t4), text_color = color.white, bgcolor = f_trendCol(t4), text_size = psz)

    strTxt = structBias == 1 ? "BULL MSS" : structBias == -1 ? "BEAR MSS" : "—"
    table.cell(panel, 0, 5, "Structure", text_color = color.silver, text_size = psz)
    table.cell(panel, 1, 5, strTxt, text_color = color.white, bgcolor = structBias == 1 ? color.new(#26a69a,0) : structBias == -1 ? color.new(#ef5350,0) : color.new(color.gray,0), text_size = psz)

// -----------------------------------------------------------------------------
//  ALERTS
// -----------------------------------------------------------------------------
alertcondition(bullMSS, "Bullish MSS + OB", "Valid bullish order block formed (MSS + liquidity + FVG).")
alertcondition(bearMSS, "Bearish MSS + OB", "Valid bearish order block formed (MSS + liquidity + FVG).")
