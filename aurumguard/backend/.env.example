# ---- AurumGuard backend environment (names only; never commit values) ----
APP_ENV=development                # development | test | staging | paper | production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./aurumguard.db   # postgresql+psycopg://user:pass@host:5432/aurumguard outside development
REDIS_URL=
AUDIT_DIR=./data/audit

SECRET_KEY=                        # >= 32 random bytes; required outside development
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120

MARKET_DATA_PROVIDER=mock          # mock | twelvedata   (twelvedata = LIVE XAU/USD prices; verify with `python -m app.check_provider`)
CALENDAR_PROVIDER=mock             # mock | none         (none = no events, so real prices are not locked out by synthetic releases)
MACRO_PROVIDER=mock                # mock only in this build (synthetic DXY/yields even with live prices)
NEWS_PROVIDER=mock                 # mock | none
PUSH_PROVIDER=mock                 # mock | webpush
TWELVEDATA_API_KEY=
TWELVEDATA_QUOTE_TTL_SECONDS=300   # UI quote cache; free tier needs >= ANALYSIS_INTERVAL_SECONDS
TWELVEDATA_ASSUMED_SPREAD_USD=0.30 # paper-trading cost assumption (price endpoint is mid-only); 0 = report zero spread
TWELVEDATA_CREDITS_PER_MINUTE=8    # plan's per-minute allowance; the adapter waits for a slot instead of taking a 429

# Outbound HTTPS trust. Python verifies against its own bundled certificate list, not the Windows /
# macOS store, so a machine whose antivirus or company proxy inspects TLS fails with
# CERTIFICATE_VERIFY_FAILED while the browser works. "auto" trusts the OS store (needs the pinned
# `truststore` package, already in requirements.txt); "certifi" forces the bundled roots.
HTTPS_TRUST=auto                   # auto | certifi
HTTPS_CA_BUNDLE=                   # optional path to a .pem file holding the inspecting root certificate

FRED_API_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

ANALYSIS_INTERVAL_SECONDS=60       # 300 on the Twelve Data free tier (~700 credits/day); 60 needs a paid plan
ANALYSIS_ENABLED=true

DEFAULT_TIMEZONE=Asia/Dubai
DEFAULT_ACCOUNT_CURRENCY=USD
DEFAULT_FRIDAY_CUTOFF_LOCAL=20:00
USD_AED_RATE=3.6725
