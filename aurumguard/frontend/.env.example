# Public URL of the FastAPI backend as seen from the browser (used for CSP connect-src and the API client)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal URL used by the Next.js server for /api rewrites (docker: http://backend:8000)
API_INTERNAL_URL=http://localhost:8000
# VAPID public key for Web Push (must match backend VAPID_PUBLIC_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
